# =========================================================
#  BBB-Lectures: конфигурация пайплайна
#  Скопируйте в .env и заполните
# =========================================================

# ── LLM (OpenAI-совместимый API) ─────────────────────────
LLM_API_KEY=sk-ЗАМЕНИТЕ_НА_ВАШ_КЛЮЧ
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# ── Whisper (распознавание речи) ─────────────────────────
# tiny | base | small | medium | large-v3
# medium — лучший баланс скорость/качество на Apple Silicon
WHISPER_MODEL=medium
WHISPER_LANGUAGE=ru

# ── Moodle (для ссылок edu.vsu.ru) ───────────────────────
# Экспортируйте куки браузера в файл (расширение "Get cookies.txt")
MOODLE_COOKIES=

# ── Пути ─────────────────────────────────────────────────
VAULT_DIR=./vault
DOCS_DIR=./docs
TMP_DIR=./tmp
SITE_DIR=./site
QUEUE_FILE=./queue.txt
PROCESSED_FILE=./processed.json

# ── Поведение ────────────────────────────────────────────
BUILD_SITE=true          # собирать сайт после обработки
DOWNLOAD_VIDEO=true      # скачивать видео (50+ МБ) — false для экономии места

# ── Курс (для тегов конспектов) ─────────────────────────
COURSE_NAME=Разработка и дизайн ИС
